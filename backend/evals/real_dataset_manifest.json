{
  "version": 1,
  "label_policy": "Roles follow source codebooks. A second score permits abstention on opaque headers without dictionary metadata. Labels and codebooks are not supplied to Luna in the baseline.",
  "datasets": [
    {
      "id": "bike",
      "filename": "bike.csv",
      "delimiter": ",",
      "source": "https://archive.ics.uci.edu/dataset/275/bike+sharing+dataset",
      "download": "https://archive.ics.uci.edu/static/public/275/bike+sharing+dataset.zip",
      "member": "hour.csv",
      "rows": 17379,
      "roles": {
        "instant": "identifier",
        "dteday": "temporal",
        "season": "categorical",
        "yr": "categorical",
        "mnth": "temporal",
        "hr": "temporal",
        "holiday": "categorical",
        "weekday": "categorical",
        "workingday": "categorical",
        "weathersit": "categorical",
        "temp": "metric",
        "atemp": "metric",
        "hum": "metric",
        "windspeed": "metric",
        "casual": "metric",
        "registered": "metric",
        "cnt": "metric"
      },
      "opaque_columns": [
        "season",
        "yr",
        "mnth",
        "hr",
        "holiday",
        "weekday",
        "workingday",
        "weathersit",
        "temp",
        "atemp",
        "hum",
        "windspeed",
        "casual",
        "registered",
        "cnt"
      ],
      "role_alternatives": {
        "mnth": [
          "categorical"
        ],
        "hr": [
          "categorical"
        ]
      },
      "x": "weekday",
      "y": "cnt",
      "aggregation": "sum",
      "queries": [
        {
          "prompt": "Show the sum of cnt by weekday",
          "kind": "chart",
          "x": "weekday",
          "y": "cnt",
          "aggregation": "sum"
        },
        {
          "prompt": "Show average temp by season",
          "kind": "chart",
          "x": "season",
          "y": "temp",
          "aggregation": "mean"
        },
        {
          "prompt": "Predict next month's number of rentals",
          "kind": "clarification"
        }
      ]
    },
