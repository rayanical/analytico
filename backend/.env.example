# Local credentials only. Copy to backend/.env (ignored by Git).
# Column interpretation is opt-in: off, jev, or luna.
COLUMN_INTERPRETER=off
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
# CSVs use DuckDB at every size and preload it during backend startup.
# pandas remains an explicit compatibility/reference override.
ANALYTICO_INGESTION_ENGINE=auto
# Luna interpreter model only; Jev is pinned to typesafe-ai/jev / typesafe-ai.
COLUMN_INTERPRETER_MODEL=gpt-6-luna
# Existing chart planning and descriptions still use this separate model.
OPENAI_MODEL=gpt-6-luna

# Schema roles use Decisions; readable labels use Responses independently.
# Set responses to restore the previous combined schema request.
COLUMN_ROLE_BACKEND=decisions

# Context ablation found no gain; keep original as the production default.
# local adds cached counts, distinct examples and aligned rows.
# summary also waits for the generated description before classifying roles.
COLUMN_ROLE_CONTEXT=original

# Overlap bounded summary/label requests with disk preparation; set 0 to roll back.
# Column-role inference still waits for complete local validation.
ANALYTICO_EARLY_AI=1

# Experimental quote-free native validation; quoted files retain Python preflight.
# No demonstrated gain on taxi/retail with strict parser parity, so keep disabled.
ANALYTICO_NATIVE_VALIDATION=0

# Optional per-dataset DuckDB worker budget (1-8, capped to available CPUs).
# Default: min(4, available CPUs); use 1 or 2 on lower-resource machines.
# ANALYTICO_DUCKDB_THREADS=2

# Chart planning: Decisions choices first, generative Luna fallback for complex requests.
# Set generative to use the generative planner for every question.
QUERY_PLANNER_BACKEND=decisions
